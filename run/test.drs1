nesting fn root() -> Int:
{dec}:
	static \r0: [Char; 12]
{0}:
	\r0 = $['h', 'e', 'l', 'l', 'o', ' ', 'w', 'o', 'r', 'l', 'd', '\n']
	%0 = call $main()
	exit $0

nesting fn printChars(<34> chars: Chars {&mut Char, Nat}) -> ():
{dec}:
	<35> i: Nat
{0}:
	<35> i = $0
	%0 = &<34> chars + $1
	%1 = *%0
	%2 = call builtin $printNat(%1)
	%3 = call builtin $printChar($'\n')
	jmp 2
{1}:
	%4 = <35> i + <34> chars
	%5 = *%4
	%6 = call builtin $printChar(%5)
	<35> i = <35> i + $1
	%7 = <35> i
{2}:
	%8 = &<34> chars + $1
	%9 = *%8
	%t = %9 > <35> i
	cj 1
	ret $()

nesting fn main() -> ():
{0}:
	%0 = (&\r0, $12)
