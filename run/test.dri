nesting fn root() -> Int:
{0}:
	%0 = call $main()
	exit $0

nesting fn main() -> ():
{dec}:
	<10> i: Nat
	<10> j: Nat
	<10> k: Nat
	<13> l: Nat
{0}:
	<10> i = $0
	<10> j = $0
	<10> k = $0
	jmp 2
{1}:
	<10> i = <10> i + $1
	%0 = call builtin $printNat(<10> i)
	<13> l = <10> k
	<10> k = <10> j
	%1 = call builtin $printChar($' ')
	%2 = call builtin $printChar($' ')
	%3 = <10> i * <10> i
	<10> j = %3 * <10> i
	%4 = call builtin $printNat(<10> j)
	%5 = call builtin $printChar($' ')
	%6 = call builtin $printChar($' ')
	<10> k = <10> j - <10> k
