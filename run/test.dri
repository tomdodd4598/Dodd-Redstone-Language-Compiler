nesting fn root() -> Int:
{def}:
	Coord: Coord {Int, Int}
{0}:
	%0 = call $main()
	exit $0

nesting fn main() -> ():
{dec}:
	<10> coord: Coord {Int, Int}
	<10> a: Int
	<10> b: Int
{0}:
	<10> coord = $Coord {3, 5}
	%0 = <10> coord
	%1 = &%0 + $0
	<10> a = *%1
	%2 = &%0 + $8
	<10> b = *%2
	%3 = call builtin $printInt(<10> a)
	%4 = call builtin $printChar($'\n')
	%5 = call builtin $printInt(<10> b)
	%6 = call builtin $printChar($'\n')
	ret $()
