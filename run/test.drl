// QUICKSORT


fn main() {
	let mut arr = [4, 7, 5, 4, 2, 6, 1, 8, 3];
	
	quicksort(&mut arr[0], 9);
	
	let mut i = 0N;
	while i < 9 {
		printInt(arr[i]);
		printChar(' ');
		i += 1;
	}
	printChar('\n');
}

fn quicksort(ptr: &mut Int, len: Nat) {
	if len < 2 {
		return;
	}

	let i = subsort(ptr, len);
	quicksort(ptr, i);
	quicksort(ptr + i, len - i);
}

fn subsort(ptr: &mut Int, len: Nat) -> Nat {
	let pivot = ptr[len >> 1];
	let mut i = 0N;
	let mut j = len - 1;
	
	loop {
		while ptr[i] < pivot {
			i += 1;
		}
		while ptr[j] > pivot {
			j -= 1;
		}

		if i >= j {
			break;
		}

		let temp = ptr[i];
		ptr[i] = ptr[j];
		ptr[j] = temp;
		
		i += 1;
		j -= 1;
	}
	
	return i;
}

