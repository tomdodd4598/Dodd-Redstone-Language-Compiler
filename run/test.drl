// QUICKSORT

/*
fn main() {
	let mut arr = [4, 7, 5, 4, 2, 6, 1, 8, 3];
	
	quicksort(&mut arr[0], 9);
	
	let mut i = 0N;
	while i < 9 {
		printInt(arr[i]);
		printChar(' ');
		i += 1;
	}
	printChar('\n');
}

fn quicksort(ptr: &mut Int, len: Nat) {
	if len < 2 {
		return;
	}

	let i = subsort(ptr, len);
	quicksort(ptr, i);
	quicksort(ptr + i, len - i);
}

fn subsort(ptr: &mut Int, len: Nat) -> Nat {
	let pivot = ptr[len >> 1];
	let mut i = 0N;
	let mut j = len - 1;
	
	loop {
		while ptr[i] < pivot {
			i += 1;
		}
		while ptr[j] > pivot {
			j -= 1;
		}

		if i >= j {
			break;
		}

		let temp = ptr[i];
		ptr[i] = ptr[j];
		ptr[j] = temp;
		
		i += 1;
		j -= 1;
	}
	
	return i;
}
*/

// ITERATOR CHAIN

/*
struct Pos {
	x: Int,
	y: Int,
}

let mut arr = [
	Pos { x: -1, y: 1 }, Pos { x: 0, y: 1 }, Pos { x: 1, y: 1 },
	Pos { x: -1, y: 0 }, Pos { x: 0, y: 0 }, Pos { x: 1, y: 0 },
	Pos { x: -1, y: -1 }, Pos { x: 0, y: -1 }, Pos { x: 1, y: -1 },
];

struct Iter {
	begin: &Pos,
	end: &Pos,
}

fn validIter(this: &Iter) -> Bool {
	return this.begin < this.end;
}

fn peekIter(this: &Iter) -> Pos {
	return *this.begin;
}

fn stepIter(this: &mut Iter) {
	this.begin += 1;
}

fn nextIter(this: &mut Iter) -> Pos {
	let next = this.begin;
	this.stepIter();
	return *next;
}

struct Filter {
	iter: Iter,
	predicate: fn(Pos) -> Bool,
}

fn prepareFilter(this: &mut Filter) {
	while this.iter.validIter() {
		let candidate = this.iter.peekIter();
		if (this.predicate)(candidate) {
			break;
		}
		this.iter.stepIter();
	}
}

fn validFilter(this: &mut Filter) -> Bool {
	this.prepareFilter();
	return this.iter.validIter();
}

fn nextFilter(this: &mut Filter) -> Pos {
	this.prepareFilter();
	return this.iter.nextIter();
}

struct Map {
	iter: Filter,
	mapper: fn(Pos) -> Int,
}

fn validMap(this: &mut Map) -> Bool {
	return this.iter.validFilter();
}

fn nextMap(this: &mut Map) -> Int {
	return (this.mapper)(this.iter.nextFilter());
}

fn foreachMap(this: &mut Map, f: fn(Int)) {
	while this.validMap() {
		f(this.nextMap());
	}
}

fn main() {
	let begin = &arr[0];
	let mut map = Map { iter: Filter { iter: Iter { begin: begin, end: begin + 9 }, predicate: |pos: Pos| pos.x != 0 && pos.y != 0 }, mapper: |pos: Pos| pos.x + pos.y };
	map.foreachMap(|x: Int| { printInt(x); printChar('\n'); });
}
*/

