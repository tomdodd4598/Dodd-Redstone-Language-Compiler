// PRIME NUMBERS

/*
const MAX = 100;
const FAIL = MAX + 1;

fn isqrt(m: Int) -> Int {
	let mut a = m;
	let mut b = 1;
	
	while a > b {
		a = (a + b) >> 1;
		b = m / a;
	}
	
	return a;
}

fn main() {
	let mut n = 1;
	
	while n < MAX {
		n += 1;
		let mut i = 2;
		let s = isqrt(n);
		
		while i <= s {
			if n % i == 0 {
				i = FAIL;
			}
			else {
				i += 1;
			}
		}
		
		if i != FAIL {
			printInt(n);
			printChar('\n');
		}
	}
}
