// NILAKANTHA PI

/*
const TERMS = 5;

struct Fraction {
	num: Int,
	den: Int,
}

fn gcd(a: Int, b: Int) -> Int {
	let mut x = a < 0 ? -a : a;
	let mut y = b < 0 ? -b : b;
	if x == 0 {
		return y;
	}
	if y == 0 {
		return x;
	}
	while x != y {
		if x > y {
			x -= y;
		}
		else {
			y -= x;
		}
	}
	return x;
}

fn divInt(a: Int, b: Int) -> Int {
	let mut x = a;
	let mut q = 0;
	while x >= b {
		x -= b;
		q += 1;
	}
	return q;
}

fn reduceFraction(this: &mut Fraction) {
	let num = this.num;
	let den = this.den;
	let d = gcd(num, den);
	if d > 1 {
		this.num = num < 0 ? -divInt(-num, d) : divInt(num, d);
		this.den = divInt(den, d);
	}
}

fn addFraction(this: &mut Fraction, other: Fraction) {
	let d = gcd(this.den, other.den);
	let left = divInt(other.den, d);
	let right = divInt(this.den, d);
	this.num = this.num * left + other.num * right;
	this.den *= left;
	this.reduceFraction();
}

fn term(a: Int, sign: Int) -> Fraction {
	let mut term = Fraction { num: 4 * sign, den: a * (a + 1) * (a + 2) };
	term.reduceFraction();
	return term;
}

fn main() {
	let mut pi = Fraction { num: 3, den: 1 };
	let mut a = 2;
	let mut sign = 1;
	
	let mut i = 0;
	while i < TERMS {
		pi.addFraction(term(a, sign));
		a += 2;
		sign = -sign;
		i += 1;
	}
	
	printInt(pi.num);
	printChar('/');
	printInt(pi.den);
	printChar('\n');
}
*/

// DESTRUCTURING TEST


